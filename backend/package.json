{
  "name": "ai-kyc-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "verify:ocr": "node scripts/verifyOcrDependencies.js",
    "verify:gridfs": "node --env-file=.env scripts/verifyGridFsService.js",
    "verify:ocr-service": "node scripts/verifyOcrService.js",
    "verify:document-processing": "node --env-file=.env scripts/verifyDocumentProcessingService.js",
    "verify:name-matching": "node scripts/verifyNameVerificationService.js",
    "verify:image-validation": "node scripts/verifyImageValidationService.js",
    "verify:ocr-recovery": "node --env-file=.env scripts/verifyOcrRecoveryService.js",
    "verify:risk-constants": "node scripts/verifyRiskConstants.js",
    "verify:risk-schema": "node scripts/verifyRiskAssessmentSchema.js",
    "verify:watchlist": "node scripts/verifyWatchlistService.js",
    "verify:risk-scoring": "node scripts/verifyRiskScoringService.js",
    "verify:risk-assessment": "node --env-file=.env scripts/verifyRiskAssessmentService.js",
    "verify:automatic-risk": "node --env-file=.env scripts/verifyAutomaticRiskAssessment.js",
    "verify:risk-retrieval": "node --env-file=.env scripts/verifyRiskAssessmentRetrieval.js",
    "verify:risk-low": "node --env-file=.env scripts/verifyLowRiskScenario.js",
    "verify:risk-medium": "node --env-file=.env scripts/verifyMediumRiskScenario.js",
    "verify:risk-high": "node --env-file=.env scripts/verifyHighRiskScenarios.js",
    "verify:risk-security": "node --env-file=.env scripts/verifyRiskSecurity.js",
    "verify:sprint4-regression": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/regression_tests.ps1",
    "verify:sprint4-evidence": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/sprint4_evidence_audit.ps1 -ExpectedCount 27",
    "verify:kyc-review-constants": "node scripts/verifyKycReviewConstants.js"
  },
  "keywords": [
    "kyc",
    "ai",
    "mongodb",
    "nodejs",
    "mit-project",
    "financial-services"
  ],
  "author": "Babajide Ibiayo",
  "license": "UNLICENSED",
  "type": "module",
  "description": "Backend API for AI-Driven KYC Automation System",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  }
}
